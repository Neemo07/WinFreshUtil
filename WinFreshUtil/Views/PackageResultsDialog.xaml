<Window x:Class="WinFreshUtil.Views.PackageResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search the package manager"
        Width="700"
        SizeToContent="Height"
        MinWidth="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="20,18,20,18">
        <TextBlock x:Name="TitleText"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="MessageText"
                   Style="{StaticResource BodyText}"
                   Margin="0,8,0,0" />

        <ListView x:Name="ResultList"
                  Height="260"
                  Margin="0,12,0,0"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  ItemContainerStyle="{StaticResource GridRow}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="ResultList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Program" Width="230" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Identifier" Width="190" DisplayMemberBinding="{Binding Id}" />
                    <GridViewColumn Header="Version" Width="100" DisplayMemberBinding="{Binding Version}" />
                    <GridViewColumn Header="Source" Width="90" DisplayMemberBinding="{Binding Source}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="16,6" MinWidth="90" />
            <Button x:Name="InstallButton"
                    Content="Install the selected program"
                    IsDefault="True"
                    Click="Install_Click"
                    Padding="16,6"
                    MinWidth="180"
                    Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
