<UserControl x:Class="WinFreshUtil.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WinFreshUtil.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Resources/AppIcon.png" Width="52" Height="52" VerticalAlignment="Top" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="WinFreshUtil" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0"
                               Text="A tiny post-install utility for fresh Windows 10 and 11 machines." />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Version" Style="{StaticResource SectionTitle}" Margin="0,22,0,6" />
            <Grid Width="360" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static models:AppInfo.Version}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Build" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static models:AppInfo.Build}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Runtime" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static models:AppInfo.Framework}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Operating system" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Static models:AppInfo.OperatingSystem}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Administrator rights" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Static models:AppInfo.IsElevated}" />
            </Grid>

            <TextBlock Text="What it does" Style="{StaticResource SectionTitle}" Margin="0,22,0,6" />
            <TextBlock Style="{StaticResource BodyText}"
                       Text="WinFreshUtil helps with the things that are left over after a fresh Windows installation. It finds the devices that have a driver problem, shows the license state of Windows and Office, and starts the community tools that apply the usual changes. Everything runs on the computer itself, nothing is sent anywhere." />


            <TextBlock Text="Log file" Style="{StaticResource SectionTitle}" Margin="0,22,0,6" />
            <TextBlock x:Name="LogPathText" Style="{StaticResource BodyText}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Open the log file" Style="{StaticResource ActionButton}" Click="OpenLog_Click" />
                <Button Content="Open the folder" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="OpenLogFolder_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
