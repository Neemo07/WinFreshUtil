<UserControl x:Class="WinFreshUtil.Views.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Drivers" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                       Text="Scans the computer for the devices that Windows reports a driver problem for, and installs the driver of the device. The driver is looked for in Windows Update first, then in the Microsoft Update Catalog, and the tool of the manufacturer is offered when nothing is found." />
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="ScanButton" Content="Scan" Style="{StaticResource ActionButton}" Click="Scan_Click" />
            <Button x:Name="WindowsUpdateButton" Content="Windows Update settings" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="WindowsUpdate_Click" />
            <Button x:Name="CancelButton" Content="Stop the installation" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="Cancel_Click" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="520" />
        </StackPanel>

        <ProgressBar x:Name="ScanProgressBar" Grid.Row="2" Height="10" Minimum="0" Maximum="100" Margin="0,12,0,0" Visibility="Collapsed" />

        <!-- Results -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="System" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SystemText" Style="{StaticResource BodyText}" />

                <TextBlock Text="Graphics" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                <TextBlock x:Name="GraphicsText" Style="{StaticResource BodyText}" />

                <TextBlock Text="Devices with a problem" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                <TextBlock x:Name="ResultText" Style="{StaticResource HintText}" Margin="0,0,0,8" />

                <ListView x:Name="DeviceList"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource BorderBrush}"
                          ItemContainerStyle="{StaticResource ListRow}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ErrorDescription}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Manufacturer}" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding HardwareIdText}" VerticalAlignment="Top" FontFamily="Consolas, Courier New" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="3" Text="{Binding ConfigManagerErrorCode}" VerticalAlignment="Top" />

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Driver pages"
                                            Tag="{Binding}"
                                            Click="FindDriver_Click"
                                            Padding="8,3"
                                            MinWidth="92" />
                                    <Button Content="Install driver"
                                            Tag="{Binding}"
                                            Click="InstallDriver_Click"
                                            Padding="8,3"
                                            MinWidth="92"
                                            Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
