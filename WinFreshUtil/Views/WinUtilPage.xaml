<UserControl x:Class="WinFreshUtil.Views.WinUtilPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <!-- A tab of the page. The line under the name marks the tab that is open. -->
        <Style x:Key="TabChip" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="14,7,14,8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="WinUtil" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,7,0,0"
                       MaxWidth="840"
                       HorizontalAlignment="Left"
                       Text="The changes of the WinUtil project, with the same names and texts. Every definition is carried inside this program and every change is made on this computer. No connection is used." />
        </StackPanel>

        <!-- Search and filters -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="340" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Height="34"
                         Padding="33,7,32,7"
                         TextChanged="SearchBox_TextChanged" />
                <Button x:Name="ClearSearchButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Width="26"
                        Height="26"
                        MinHeight="26"
                        FontSize="11"
                        Margin="0,0,4,0"
                        Content="&#xE711;"
                        AutomationProperties.Name="Clear the search"
                        ToolTip="Clear the search"
                        Visibility="Collapsed"
                        Click="ClearSearch_Click" />
                <TextBlock Text="&#xE721;"
                           FontFamily="{StaticResource GlyphFontFamily}"
                           FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="11,0,0,0"
                           IsHitTestVisible="False" />
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Search changes and features"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="33,0,0,0"
                           IsHitTestVisible="False" />
            </Grid>

            <ComboBox x:Name="CategoryBox"
                      Grid.Column="1"
                      Width="190"
                      Margin="10,0,0,0"
                      SelectionChanged="CategoryBox_SelectionChanged" />
        </Grid>

        <!-- Tabs and the presets of the Tweaks tab -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TabBar" Grid.Column="0" Orientation="Horizontal">
                <RadioButton x:Name="TabTweaks"
                             Style="{StaticResource TabChip}"
                             Content="Tweaks"
                             GroupName="WinUtilTabs"
                             IsChecked="True"
                             Checked="Tab_Checked" />
                <RadioButton x:Name="TabConfig"
                             Style="{StaticResource TabChip}"
                             Content="Config"
                             GroupName="WinUtilTabs"
                             Checked="Tab_Checked" />
                <RadioButton x:Name="TabUpdates"
                             Style="{StaticResource TabChip}"
                             Content="Updates"
                             GroupName="WinUtilTabs"
                             Checked="Tab_Checked" />
            </StackPanel>

            <StackPanel x:Name="PresetBar"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,4">
                <TextBlock Text="Presets"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
            </StackPanel>
        </Grid>

        <!-- Action bar -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ApplyButton"
                        Content="Apply selected"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="132"
                        Click="Apply_Click" />
                <Button x:Name="UndoButton"
                        Grid.Column="1"
                        Content="Undo selected"
                        Style="{StaticResource ActionButton}"
                        Margin="8,0,0,0"
                        Click="Undo_Click" />
                <Button Grid.Column="2"
                        Content="Clear"
                        Style="{StaticResource GhostButton}"
                        MinWidth="58"
                        Margin="8,0,0,0"
                        Click="ClearSelection_Click" />
                <TextBlock x:Name="SelectionText"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Nothing selected" />
                <ProgressBar x:Name="RunProgress"
                             Grid.Column="4"
                             Width="150"
                             Height="4"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,14,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="5"
                           VerticalAlignment="Center"
                           MaxWidth="430"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Ready" />
            </Grid>

            <ScrollViewer x:Name="ContentScroll"
                          Grid.Row="1"
                          Margin="0,14,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <Grid>
                    <StackPanel x:Name="SectionsPanel" Margin="0,0,6,20" />
                    <StackPanel x:Name="UpdatesPanel" Margin="0,0,6,20" Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Activity log -->
        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,1,0,0"
                Margin="-26,0,-26,0"
                Padding="20,8,20,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Activity log"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LogStatus"
                               Grid.Column="1"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Text="No work has run yet." />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Clear"
                                Style="{StaticResource GhostButton}"
                                MinWidth="52"
                                MinHeight="26"
                                Padding="8,3"
                                Click="ClearLog_Click" />
                        <Button x:Name="LogToggle"
                                Content="&#xE70D;"
                                Style="{StaticResource IconButton}"
                                Click="LogToggle_Click"
                                ToolTip="Hide the activity log"
                                AutomationProperties.Name="Hide the activity log" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="LogScroll"
                              Grid.Row="1"
                              MaxHeight="150"
                              Margin="0,6,0,2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LogPanel" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
