<UserControl x:Class="WinFreshUtil.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- The button of one program. -->
        <Style x:Key="AppTile" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="202" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Outer"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="FossBar"
                                        Grid.Column="0"
                                        Width="3"
                                        Margin="1,6,0,6"
                                        Background="{DynamicResource SuccessBrush}"
                                        CornerRadius="2"
                                        Visibility="Collapsed" />

                                <Border x:Name="Icon"
                                        Grid.Column="1"
                                        Width="26"
                                        Height="26"
                                        CornerRadius="4"
                                        Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Initials"
                                               Text="{Binding Initials}"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <Grid Grid.Column="2" Margin="0,0,4,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="Label"
                                               Grid.Row="0"
                                               Text="{Binding Name}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <Grid Grid.Row="1" Margin="0,2,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ProgressBar x:Name="Bar"
                                                     Grid.Column="0"
                                                     Height="4"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     BorderThickness="0"
                                                     Background="{DynamicResource SurfaceHoverBrush}"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Value="{Binding Progress}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Visibility="Collapsed" />

                                        <TextBlock x:Name="PercentText"
                                                   Grid.Column="1"
                                                   Text="{Binding ProgressText}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </Grid>

                                <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse x:Name="Badge" Width="13" Height="13" Fill="{DynamicResource BorderStrongBrush}" />
                                    <TextBlock x:Name="BadgeMark"
                                               Text="✓"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-1,0,0"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFoss}" Value="True">
                                <Setter TargetName="FossBar" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                <Setter TargetName="Badge" Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                <Setter TargetName="BadgeMark" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                <Setter TargetName="Badge" Property="Fill" Value="{DynamicResource DangerBrush}" />
                                <Setter TargetName="BadgeMark" Property="Text" Value="!" />
                                <Setter TargetName="BadgeMark" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PercentText" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A button of the column on the left. -->
        <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SideToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Outer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A group of the list on the right. -->
        <Style x:Key="CategoryGroup" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The name of the page and the state of the work. -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Install apps" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                       Text="The list of programs of the WinUtil project. A program is installed with the package manager of Windows or with Chocolatey, from the sources that are set up on this computer." />
            <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <!-- The progress of the whole run. -->
            <Grid x:Name="OverallPanel" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="OverallText"
                           Grid.Row="0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,5"
                           TextWrapping="Wrap" />

                <ProgressBar x:Name="OverallBar"
                             Grid.Row="1"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             BorderThickness="0"
                             Background="{DynamicResource SurfaceHoverBrush}"
                             Foreground="{DynamicResource AccentBrush}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBox x:Name="SearchBox"
                         Width="250"
                         Padding="6,4"
                         ToolTip="Type a name to show only the programs with that name."
                         TextChanged="SearchBox_TextChanged" />
                <Button x:Name="SearchPackagesButton"
                        Content="Search the package manager of Windows"
                        Style="{StaticResource ActionButton}"
                        Margin="8,0,0,0"
                        Click="SearchPackages_Click" />
            </StackPanel>
        </StackPanel>

        <!-- The groups of the list. -->
        <WrapPanel x:Name="CategoryBar" Grid.Row="1" Margin="0,12,0,0" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The column on the left. -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,12,12,12"
                    Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Actions" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Button Content="Install/Upgrade Applications" Style="{StaticResource SideButton}" Click="Install_Click" />
                    <Button Content="Uninstall Applications" Style="{StaticResource SideButton}" Click="Uninstall_Click" />
                    <Button Content="Upgrade all Applications" Style="{StaticResource SideButton}" Click="UpgradeAll_Click" />
                    <Button x:Name="StopButton" Content="Stop the work" Style="{StaticResource SideButton}" IsEnabled="False" Click="Stop_Click" />

                    <TextBlock Text="Package Manager" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <RadioButton x:Name="ChocoOption" Content="Chocolatey" Margin="0,0,0,4" FontSize="11" Checked="Manager_Changed" />
                    <RadioButton x:Name="WingetOption" Content="WinGet" Margin="0,0,0,0" FontSize="11" IsChecked="True" Checked="Manager_Changed" />

                    <TextBlock Text="Selection" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <Button Content="Clear Selection" Style="{StaticResource SideButton}" Click="ClearSelection_Click" />
                    <Button Content="Collapse All Categories" Style="{StaticResource SideButton}" Click="CollapseAll_Click" />
                    <Button Content="Expand All Categories" Style="{StaticResource SideButton}" Click="ExpandAll_Click" />
                    <Button x:Name="SelectedButton" Content="Selected Apps: 0" Style="{StaticResource SideButton}" Click="SelectedApps_Click" />
                    <ToggleButton x:Name="InstalledToggle" Content="Show Installed Apps" Style="{StaticResource SideToggle}" Click="ShowInstalled_Click" />
                    <Button x:Name="RefreshInstalledButton" Content="Refresh the installed programs" Style="{StaticResource SideButton}" Click="RefreshInstalled_Click" />

                    <TextBlock Foreground="{DynamicResource SuccessBrush}" FontSize="11" Margin="0,14,0,0" Text="▮ Free and open source software" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- The programs. -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CategoryPanel" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
