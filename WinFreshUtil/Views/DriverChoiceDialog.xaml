<Window x:Class="WinFreshUtil.Views.DriverChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install a driver"
        Width="700"
        SizeToContent="Height"
        MinWidth="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="20,18,20,18">
        <TextBlock x:Name="TitleText"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="MessageText"
                   Style="{StaticResource BodyText}"
                   Margin="0,10,0,0" />

        <TextBlock x:Name="ListTitle"
                   Style="{StaticResource SectionTitle}"
                   Margin="0,14,0,6" />

        <ListView x:Name="CandidateList"
                  Height="170"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  ItemContainerStyle="{StaticResource GridRow}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="CandidateList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Driver" Width="300" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Version" Width="120" DisplayMemberBinding="{Binding Version}" />
                    <GridViewColumn Header="Comes from" Width="180" DisplayMemberBinding="{Binding Source}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="12,10,12,10"
                Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="The driver that is installed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="DriverText"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />

                <TextBlock Text="Exactly what will run" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" />
                <TextBlock x:Name="CommandText"
                           FontFamily="Consolas, Courier New"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />

                <TextBlock Text="Downloaded from" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" />
                <TextBlock x:Name="SourceText"
                           FontFamily="Consolas, Courier New"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="WarningText"
                   Style="{StaticResource HintText}"
                   Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="16,6" MinWidth="90" />
            <Button x:Name="ConfirmButton"
                    Content="Install the driver"
                    IsDefault="True"
                    Click="Confirm_Click"
                    Padding="16,6"
                    MinWidth="130"
                    Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
