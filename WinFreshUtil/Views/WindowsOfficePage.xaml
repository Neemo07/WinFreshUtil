<UserControl x:Class="WinFreshUtil.Views.WindowsOfficePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WinFreshUtil.Models">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Windows &amp; Office" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                       Text="Read-only status of the Windows and Microsoft Office licenses on this machine. This page never changes your licensing." />
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource ActionButton}" Click="Refresh_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Results -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Windows" Style="{StaticResource SectionTitle}" />
                <StackPanel x:Name="WindowsPanel" />

                <TextBlock Text="Microsoft Office" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
                <StackPanel x:Name="OfficePanel" />

                <TextBlock Text="Notes" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
                <StackPanel x:Name="NotesPanel" />
            </StackPanel>
        </ScrollViewer>

        <!-- Microsoft Activation Scripts -->
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="Microsoft Activation Scripts (MAS)" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10"
                       Text="Runs the open source MAS scripts that are carried inside this application, so activation works without internet. The list of functions is read from the script itself. Updating the scripts from GitHub is the only step that needs a connection." />

            <StackPanel Orientation="Horizontal">
                <Button x:Name="MasMenuButton" Content="Choose a MAS function" Style="{StaticResource ActionButton}" Click="MasMenuButton_Click" />
                <Button x:Name="MasUpdateButton" Content="Update MAS from GitHub" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="MasUpdateButton_Click" />
            </StackPanel>

            <TextBlock x:Name="MasVersionText" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />

            <ProgressBar x:Name="MasProgressBar" Height="14" Minimum="0" Maximum="100" Margin="0,12,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="ActivationStatusText" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
